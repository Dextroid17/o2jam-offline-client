[Desktop Entry]
Type=Application
Version=1.0
Name=Install O2Jam Offline Client
Comment=Graphical installer for the O2Jam Offline Client
Exec=bash -c 'd="$(dirname "$0")"; exec python3 "$d/o2jam-installer.py"' %k
Icon=system-software-install
Terminal=false
Categories=Game;Utility;
Keywords=o2jam;install;game;
StartupNotify=true
