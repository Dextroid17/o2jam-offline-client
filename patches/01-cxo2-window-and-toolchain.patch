+        // the two layouts are identical otherwise. Parsing with the wrong width desynchronises
+        // every following field, so the caller probes both and keeps whichever fits.
+        template<typename TQuantity>
+        void ParseItems(sf::InputStream& stream, const Gx::ResourceContext& ctx, const std::uint32_t count, ItemData& itemData)
+        {
+                #pragma pack(push, 1)
+                struct ItemInfo
+                {
+                    std::uint32_t ID;
+                    EquipmentType Type;
+                    Cx::Planet    Planet;
+                    std::uint16_t Flag;
+                    TQuantity     Quantity;
+                    std::uint8_t  MoidifierEffect;
